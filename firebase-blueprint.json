{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile entity containing account info and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "LogoItem": {
      "title": "LogoItem",
      "description": "Saved company logo generated by AI",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "companyName": { "type": "string", "maxLength": 128 },
        "industry": { "type": "string", "maxLength": 64 },
        "style": { "type": "string", "maxLength": 64 },
        "colorPalette": { "type": "string", "maxLength": 64 },
        "promptUsed": { "type": "string", "maxLength": 2048 },
        "imageUrl": { "type": "string", "maxLength": 2097152 },
        "imageSize": { "type": "string", "maxLength": 16 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "companyName", "imageUrl", "createdAt"]
    },
    "VideoItem": {
      "title": "VideoItem",
      "description": "Generated animated video or Veo video clip",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 128 },
        "prompt": { "type": "string", "maxLength": 2048 },
        "videoUrl": { "type": "string", "maxLength": 2097152 },
        "aspectRatio": { "type": "string", "maxLength": 16 },
        "resolution": { "type": "string", "maxLength": 16 },
        "modelUsed": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title", "videoUrl", "createdAt"]
    },
    "PaletteItem": {
      "title": "PaletteItem",
      "description": "Complementary brand color palette generated for a company",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "companyName": { "type": "string", "maxLength": 128 },
        "paletteJson": { "type": "string", "maxLength": 65536 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "companyName", "paletteJson", "createdAt"]
    },
    "MusicItem": {
      "title": "MusicItem",
      "description": "Brand soundtrack or audio clip generated with Lyria",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 128 },
        "prompt": { "type": "string", "maxLength": 2048 },
        "audioUrl": { "type": "string", "maxLength": 2097152 },
        "durationSeconds": { "type": "number" },
        "genre": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title", "audioUrl", "createdAt"]
    },
    "VerificationReport": {
      "title": "VerificationReport",
      "description": "Google Search Grounded trademark and business name verification report",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "companyName": { "type": "string", "maxLength": 128 },
        "availabilityScore": { "type": "number" },
        "riskLevel": { "type": "string", "maxLength": 32 },
        "summary": { "type": "string", "maxLength": 4096 },
        "norwayStatus": { "type": "string", "maxLength": 2048 },
        "globalStatus": { "type": "string", "maxLength": 2048 },
        "sourcesJson": { "type": "string", "maxLength": 16384 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "companyName", "availabilityScore", "riskLevel", "createdAt"]
    },
    "StudioProject": {
      "title": "StudioProject",
      "description": "Complete end-to-end BrandForge Studio project encompassing brand identity, strategy, storyboard, timeline and video assets",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "productOrService": { "type": "string", "maxLength": 512 },
        "companyName": { "type": "string", "maxLength": 128 },
        "industry": { "type": "string", "maxLength": 128 },
        "brandLogoUrl": { "type": "string", "maxLength": 2097152 },
        "renderedVideoUrl": { "type": "string", "maxLength": 2097152 },
        "projectJson": { "type": "string", "maxLength": 524288 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "name", "projectJson", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile records indexed by auth UID"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "StudioProject",
      "description": "User end-to-end studio projects"
    },
    "/users/{userId}/logos/{logoId}": {
      "schema": "LogoItem",
      "description": "User logos generated and saved"
    },
    "/users/{userId}/videos/{videoId}": {
      "schema": "VideoItem",
      "description": "User animated and synthesized videos"
    },
    "/users/{userId}/palettes/{paletteId}": {
      "schema": "PaletteItem",
      "description": "User brand color palettes"
    },
    "/users/{userId}/music/{musicId}": {
      "schema": "MusicItem",
      "description": "User generated brand soundtracks"
    },
    "/users/{userId}/verifications/{checkId}": {
      "schema": "VerificationReport",
      "description": "Trademark and business registration verification reports"
    }
  }
}
