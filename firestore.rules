rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validation helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidLogoItem(data) {
      return data.keys().hasAll(['id', 'userId', 'companyName', 'imageUrl', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'companyName', 'industry', 'style', 'colorPalette', 'promptUsed', 'imageUrl', 'imageSize', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.companyName is string && data.companyName.size() <= 128 &&
        data.imageUrl is string && data.imageUrl.size() <= 2097152 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('industry' in data) || (data.industry is string && data.industry.size() <= 64)) &&
        (!('style' in data) || (data.style is string && data.style.size() <= 64)) &&
        (!('colorPalette' in data) || (data.colorPalette is string && data.colorPalette.size() <= 64)) &&
        (!('promptUsed' in data) || (data.promptUsed is string && data.promptUsed.size() <= 2048)) &&
        (!('imageSize' in data) || (data.imageSize is string && data.imageSize.size() <= 16));
    }

    function isValidVideoItem(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'videoUrl', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'prompt', 'videoUrl', 'aspectRatio', 'resolution', 'modelUsed', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.title is string && data.title.size() <= 128 &&
        data.videoUrl is string && data.videoUrl.size() <= 2097152 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('prompt' in data) || (data.prompt is string && data.prompt.size() <= 2048)) &&
        (!('aspectRatio' in data) || (data.aspectRatio is string && data.aspectRatio.size() <= 16)) &&
        (!('resolution' in data) || (data.resolution is string && data.resolution.size() <= 16)) &&
        (!('modelUsed' in data) || (data.modelUsed is string && data.modelUsed.size() <= 64));
    }

    function isValidPaletteItem(data) {
      return data.keys().hasAll(['id', 'userId', 'companyName', 'paletteJson', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'companyName', 'paletteJson', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.companyName is string && data.companyName.size() <= 128 &&
        data.paletteJson is string && data.paletteJson.size() <= 65536 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidMusicItem(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'audioUrl', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'prompt', 'audioUrl', 'durationSeconds', 'genre', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.title is string && data.title.size() <= 128 &&
        data.audioUrl is string && data.audioUrl.size() <= 2097152 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('prompt' in data) || (data.prompt is string && data.prompt.size() <= 2048)) &&
        (!('durationSeconds' in data) || (data.durationSeconds is number)) &&
        (!('genre' in data) || (data.genre is string && data.genre.size() <= 64));
    }

    function isValidVerificationReport(data) {
      return data.keys().hasAll(['id', 'userId', 'companyName', 'availabilityScore', 'riskLevel', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'companyName', 'availabilityScore', 'riskLevel', 'summary', 'norwayStatus', 'globalStatus', 'sourcesJson', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.companyName is string && data.companyName.size() <= 128 &&
        data.availabilityScore is number &&
        data.riskLevel is string && data.riskLevel.size() <= 32 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('summary' in data) || (data.summary is string && data.summary.size() <= 4096)) &&
        (!('norwayStatus' in data) || (data.norwayStatus is string && data.norwayStatus.size() <= 2048)) &&
        (!('globalStatus' in data) || (data.globalStatus is string && data.globalStatus.size() <= 2048)) &&
        (!('sourcesJson' in data) || (data.sourcesJson is string && data.sourcesJson.size() <= 16384));
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().uid == userId;
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().uid == userId && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId);

      // User logos
      match /logos/{logoId} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logoId) && isValidLogoItem(incoming()) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(logoId) && isValidLogoItem(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
      }

      // User videos
      match /videos/{videoId} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(videoId) && isValidVideoItem(incoming()) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(videoId) && isValidVideoItem(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
      }

      // User palettes
      match /palettes/{paletteId} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(paletteId) && isValidPaletteItem(incoming()) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(paletteId) && isValidPaletteItem(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
      }

      // User music
      match /music/{musicId} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(musicId) && isValidMusicItem(incoming()) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(musicId) && isValidMusicItem(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
      }

      // User brand verifications
      match /verifications/{checkId} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(checkId) && isValidVerificationReport(incoming()) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(checkId) && isValidVerificationReport(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
      }
    }
  }
}
